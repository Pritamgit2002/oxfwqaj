# --- Database (docker compose provides Postgres on 5432) ---
POSTGRES_USER=windsight
POSTGRES_PASSWORD=windsight
POSTGRES_DB=windsight
DATABASE_URL=postgresql+psycopg://windsight:windsight@localhost:5432/windsight
# Without Docker you can use SQLite instead:
# DATABASE_URL=sqlite:///./windsight.db

# --- API ---
CORS_ORIGINS=["http://localhost:3000"]
DEFAULT_DECISION_CUTOFF=09:00

# --- Web (server-side only; the browser never calls the API directly) ---
API_BASE_URL=http://localhost:8000
